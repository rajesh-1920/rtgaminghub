* {
	box-sizing: border-box;
}

:root {
	/* Premium color palette */
	--bg-dark: #0a0e27;
	--bg-gradient: linear-gradient(135deg, #0a0e27 0%, #1a1a3e 50%, #0f1035 100%);
	--surface: rgba(20, 24, 60, 0.5);
	--surface-light: rgba(30, 35, 80, 0.6);
	--surface-hover: rgba(40, 50, 120, 0.7);
	--border: rgba(100, 150, 255, 0.1);
	--border-light: rgba(100, 150, 255, 0.05);
	--text: #e5eaf5;
	--text-muted: #a8b5d1;
	--text-dim: #7a84a0;

	/* Premium accent colors */
	--primary: #3b82f6;
	--primary-dark: #1e40af;
	--primary-light: #60a5fa;
	--accent: #8b5cf6;
	--accent-light: #a78bfa;
	--success: #10b981;
	--success-light: #34d399;
	--danger: #ef4444;
	--warning: #f59e0b;

	/* Effects */
	--shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.3);
	--shadow-md: 0 12px 32px rgba(0, 0, 0, 0.4);
	--shadow-lg: 0 20px 48px rgba(0, 0, 0, 0.5);
	--glow: 0 0 20px rgba(59, 130, 246, 0.1);
}

html {
	color-scheme: dark;
}

body {
	margin: 0;
	width: 100%;
	height: 100dvh;
	min-height: 100dvh;
	font-family: 'Segoe UI', Trebuchet MS, system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
	font-size: 18px;
	font-weight: 500;
	color: var(--text);
	background: var(--bg-gradient);
	overflow: hidden;
	-webkit-font-smoothing: antialiased;
	-moz-osx-font-smoothing: grayscale;
}

body::before {
	content: '';
	position: fixed;
	inset: 0;
	background: radial-gradient(circle at 20% 50%, rgba(59, 130, 246, 0.08) 0%, transparent 50%),
	            radial-gradient(circle at 80% 80%, rgba(139, 92, 246, 0.06) 0%, transparent 50%);
	pointer-events: none;
	z-index: -1;
}

a {
	color: inherit;
	text-decoration: none;
	transition: color 0.3s ease;
}

button, a {
	-webkit-tap-highlight-color: transparent;
}

.bg-glow {
	position: fixed;
	border-radius: 999px;
	filter: blur(10px);
	pointer-events: none;
	opacity: 0.7;
	display: none;
}

.page-shell {
	width: 100%;
	height: 100dvh;
	padding: 1rem 1.5rem;
	position: relative;
	z-index: 1;
	display: flex;
	flex-direction: column;
	gap: 1rem;
}

/* Topbar */
.topbar {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 0.5rem 0;
	border-bottom: 1px solid var(--border);
	backdrop-filter: blur(8px);
}

.topbar .back {
	color: var(--primary-light);
	font-weight: 600;
	font-size: 0.95rem;
	padding: 0.5rem 0.8rem;
	border-radius: 8px;
	cursor: pointer;
	transition: all 0.3s ease;
}

.topbar .back:hover {
	background: var(--surface);
	color: var(--text);
}

.topbar .title {
	font-weight: 700;
	font-size: 1.2rem;
	color: var(--text);
	text-transform: uppercase;
	letter-spacing: 0.08em;
}

/* Main Container */
.center-grid {
	flex: 1;
	width: 100%;
	max-width: 1300px;
	margin: 0 auto;
	padding: 2rem;
	display: grid;
	grid-template-columns: 1fr 450px;
	grid-auto-rows: auto;
	gap: 1.5rem;
	background: var(--surface);
	border: 1px solid var(--border);
	border-radius: 24px;
	backdrop-filter: blur(20px);
	box-shadow: var(--shadow-lg), var(--glow);
	overflow-y: auto;
	align-content: start;
	animation: floatIn 0.6s cubic-bezier(0.2, 0.9, 0.3, 1);
}

.center-grid::-webkit-scrollbar {
	width: 6px;
}

.center-grid::-webkit-scrollbar-track {
	background: transparent;
}

.center-grid::-webkit-scrollbar-thumb {
	background: var(--border);
	border-radius: 3px;
}

.center-grid::-webkit-scrollbar-thumb:hover {
	background: rgba(100, 150, 255, 0.2);
}

/* Page Header */
.page-header {
	grid-column: 1 / 2;
	display: flex;
	flex-direction: column;
	gap: 0.5rem;
}

.page-header .title {
	font-size: 2.8rem;
	font-weight: 800;
	background: linear-gradient(135deg, var(--primary-light), var(--accent-light));
	-webkit-background-clip: text;
	-webkit-text-fill-color: transparent;
	background-clip: text;
	letter-spacing: -0.02em;
	margin: 0;
}

.subtitle {
	color: var(--text-muted);
	font-size: 1rem;
	font-weight: 400;
	letter-spacing: 0.02em;
	margin: 0;
}

/* Scoreboard */
.scoreboard {
	grid-column: 1 / 2;
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 1rem;
}

.score-item {
	padding: 1.5rem;
	background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(139, 92, 246, 0.05));
	border: 1px solid var(--border);
	border-radius: 16px;
	text-align: center;
	backdrop-filter: blur(12px);
	transition: all 0.3s ease;
}

.score-item:hover {
	background: linear-gradient(135deg, rgba(59, 130, 246, 0.15), rgba(139, 92, 246, 0.1));
	border-color: rgba(100, 150, 255, 0.2);
	transform: translateY(-2px);
	box-shadow: var(--shadow-md);
}

.score-item .label {
	font-size: 0.85rem;
	font-weight: 600;
	color: var(--text-muted);
	text-transform: uppercase;
	letter-spacing: 0.08em;
	margin: 0 0 0.5rem 0;
}

.score-item .value {
	font-size: 3.2rem;
	font-weight: 800;
	color: var(--primary-light);
	letter-spacing: -0.02em;
	margin: 0;
}

/* Choices Container */
.choices {
	grid-column: 1 / 2;
	display: flex;
	gap: 1.5rem;
	justify-content: center;
	align-items: center;
	padding: 2rem 1rem;
	background: linear-gradient(135deg, rgba(59, 130, 246, 0.06), rgba(139, 92, 246, 0.04));
	border: 1px solid var(--border);
	border-radius: 20px;
	backdrop-filter: blur(12px);
}

.choice {
	width: 240px;
	height: 240px;
	padding: 0;
	border: 2px solid var(--border);
	background: linear-gradient(135deg, var(--surface-light), var(--surface));
	border-radius: 20px;
	cursor: pointer;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 0.8rem;
	transition: all 0.3s cubic-bezier(0.2, 0.9, 0.3, 1);
	position: relative;
	overflow: hidden;
}

.choice::before {
	content: '';
	position: absolute;
	inset: 0;
	background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.1), transparent 60%);
	opacity: 0;
	transition: opacity 0.3s ease;
	pointer-events: none;
}

.choice:hover {
	border-color: rgba(100, 150, 255, 0.3);
	background: linear-gradient(135deg, var(--surface-hover), var(--surface-light));
	transform: translateY(-8px);
	box-shadow: var(--shadow-lg), var(--glow);
}

.choice:hover::before {
	opacity: 1;
}

.choice:active {
	transform: translateY(-4px) scale(0.98);
}

.choice:focus {
	outline: none;
}

.choice:focus-visible {
	box-shadow: 0 0 0 3px var(--primary-dark), 0 0 0 6px var(--primary-light);
}

.choice .emoji {
	font-size: 7.5rem;
	line-height: 1;
	transition: transform 0.3s ease;
	display: block;
}

.choice:hover .emoji {
	transform: scale(1.1) rotate(5deg);
}

.choice .name {
	font-size: 1.15rem;
	font-weight: 700;
	color: var(--text);
	letter-spacing: 0.05em;
	text-transform: uppercase;
	margin: 0;
}

/* Outcome States */
.choice.is-win {
	border-color: rgba(16, 185, 129, 0.5);
	background: linear-gradient(135deg, rgba(16, 185, 129, 0.15), rgba(16, 185, 129, 0.08));
	box-shadow: 0 0 0 2px var(--primary-dark), 0 0 30px rgba(16, 185, 129, 0.25);
	transform: scale(1.05);
}

.choice.is-lose {
	border-color: rgba(239, 68, 68, 0.5);
	background: linear-gradient(135deg, rgba(239, 68, 68, 0.12), rgba(239, 68, 68, 0.06));
	box-shadow: 0 0 0 2px var(--primary-dark), 0 0 30px rgba(239, 68, 68, 0.15);
	opacity: 0.9;
}

.choice.is-draw {
	border-color: rgba(59, 130, 246, 0.5);
	background: linear-gradient(135deg, rgba(59, 130, 246, 0.12), rgba(59, 130, 246, 0.06));
	box-shadow: 0 0 0 2px var(--primary-dark), 0 0 30px rgba(59, 130, 246, 0.2);
}

/* Status Row */
.status-row {
	grid-column: 1 / 2;
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 1rem;
	padding: 1.5rem;
	background: linear-gradient(135deg, rgba(16, 185, 129, 0.08), rgba(59, 130, 246, 0.06));
	border: 1px solid var(--border);
	border-radius: 16px;
	backdrop-filter: blur(12px);
}

#status-text {
	font-weight: 700;
	font-size: 1.25rem;
	color: var(--text);
	letter-spacing: 0.02em;
	margin: 0;
}

#player-pick,
#computer-pick {
	color: var(--text-muted);
	font-size: 0.95rem;
	font-weight: 500;
	margin: 0;
}

#streak-text {
	color: var(--primary-light);
	font-weight: 600;
	font-size: 1rem;
	margin: 0;
}

/* Controls */
.controls {
	grid-column: 1 / 2;
	display: flex;
	gap: 1rem;
	justify-content: center;
	align-items: center;
	flex-wrap: wrap;
}

.button {
	padding: 0.8rem 1.6rem;
	font-size: 0.95rem;
	font-weight: 700;
	border-radius: 12px;
	border: none;
	cursor: pointer;
	transition: all 0.3s ease;
	text-transform: uppercase;
	letter-spacing: 0.08em;
}

.button-primary {
	background: linear-gradient(135deg, var(--primary), var(--primary-dark));
	color: #fff;
	box-shadow: var(--shadow-md), 0 0 20px rgba(59, 130, 246, 0.3);
}

.button-primary:hover {
	transform: translateY(-2px);
	box-shadow: var(--shadow-lg), 0 0 30px rgba(59, 130, 246, 0.4);
}

.button-primary:active {
	transform: translateY(0);
}

.button-secondary {
	background: var(--surface-hover);
	color: var(--primary-light);
	border: 1px solid var(--border);
}

.button-secondary:hover {
	border-color: rgba(100, 150, 255, 0.3);
	transform: translateY(-2px);
}

/* Rules Row */
.rules-row {
	grid-column: 1 / 2;
	display: flex;
	gap: 0.75rem;
	align-items: center;
	flex-wrap: wrap;
}

.rule-pill {
	display: inline-flex;
	align-items: center;
	gap: 0.5rem;
	padding: 0.6rem 1rem;
	background: linear-gradient(135deg, rgba(59, 130, 246, 0.12), rgba(139, 92, 246, 0.08));
	border: 1px solid var(--border);
	border-radius: 20px;
	font-size: 0.9rem;
	color: var(--text-muted);
	white-space: nowrap;
	transition: all 0.3s ease;
}

.rule-pill:hover {
	border-color: rgba(100, 150, 255, 0.3);
	background: linear-gradient(135deg, rgba(59, 130, 246, 0.18), rgba(139, 92, 246, 0.12));
	color: var(--text);
}

.rule-pill .emoji {
	font-size: 1.05rem;
	line-height: 1;
	display: block;
}

/* Right Sidebar Panels */
.right-sidebar {
	grid-column: 2 / 3;
	grid-row: 1 / -1;
	display: flex;
	flex-direction: column;
	gap: 1.5rem;
}

/* History Panel */
.history-panel,
.info-panel {
	padding: 1.25rem;
	background: linear-gradient(135deg, var(--surface-light), var(--surface));
	border: 1px solid var(--border);
	border-radius: 16px;
	backdrop-filter: blur(12px);
}

.history-panel h3,
.info-panel h3 {
	margin: 0 0 1rem 0;
	font-size: 1.1rem;
	font-weight: 700;
	text-transform: uppercase;
	letter-spacing: 0.08em;
	color: var(--text);
}

#recent-rounds {
	list-style: none;
	margin: 0;
	padding: 0;
	display: flex;
	flex-direction: column;
	gap: 0.75rem;
	max-height: 380px;
	overflow-y: auto;
	padding-right: 0.5rem;
}

#recent-rounds::-webkit-scrollbar {
	width: 4px;
}

#recent-rounds::-webkit-scrollbar-track {
	background: transparent;
}

#recent-rounds::-webkit-scrollbar-thumb {
	background: var(--border);
	border-radius: 2px;
}

#recent-rounds li {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 0.75rem;
	padding: 0.75rem 0.85rem;
	background: rgba(255, 255, 255, 0.05);
	border: 1px solid var(--border-light);
	border-radius: 12px;
	font-size: 0.95rem;
	transition: all 0.2s ease;
}

#recent-rounds li:hover {
	background: rgba(255, 255, 255, 0.08);
	border-color: var(--border);
}

/* Info Panel */
.info-panel {
	flex: 1;
}

.info-panel p {
	margin: 0 0 0.75rem 0;
	color: var(--text-muted);
	font-size: 0.95rem;
	line-height: 1.6;
}

.meta-list {
	display: flex;
	flex-direction: column;
	gap: 0.8rem;
	margin: 0;
	padding: 0;
	list-style: none;
}

.meta-list li {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 0.75rem;
	background: rgba(255, 255, 255, 0.05);
	border-radius: 10px;
	font-size: 0.95rem;
	color: var(--text-muted);
}

.meta-list strong {
	color: var(--text);
	font-weight: 700;
}

/* Animations */
@keyframes pop {
	0% { 
		transform: scale(0.85); 
		opacity: 0; 
	}
	50% { 
		transform: scale(1.08); 
	}
	100% { 
		transform: scale(1); 
		opacity: 1; 
	}
}

@keyframes shake {
	0%, 100% { transform: translateX(0); }
	25% { transform: translateX(-8px); }
	50% { transform: translateX(8px); }
	75% { transform: translateX(-8px); }
}

@keyframes floatIn {
	from {
		transform: translateY(12px);
		opacity: 0;
	}
	to {
		transform: translateY(0);
		opacity: 1;
	}
}

@keyframes spin {
	from { transform: rotate(0deg); }
	to { transform: rotate(360deg); }
}

@keyframes spin-reverse {
	from { transform: rotate(360deg); }
	to { transform: rotate(0deg); }
}

.pop { animation: pop 0.4s cubic-bezier(0.2, 0.9, 0.3, 1) forwards; }
.shake { animation: shake 0.5s ease-in-out; }

/* Hidden or legacy elements */
.choice-grid,
.choice-card,
.hero-illustration,
.icon-icon,
.game-layout,
.panel,
.rule-item,
.progress-card,
.result-banner,
.panel-header,
.panel h2,
.round-counter {
	display: none;
}

/* Responsive Design - Tablet */
@media (max-width: 1100px) {
	.center-grid {
		grid-template-columns: 1fr;
		padding: 1.5rem;
	}

	.right-sidebar {
		grid-column: 1 / -1;
		flex-direction: row;
	}

	.history-panel,
	.info-panel {
		flex: 1;
	}

	.choice {
		width: 200px;
		height: 200px;
	}

	.choice .emoji {
		font-size: 6rem;
	}
}

/* Responsive Design - Mobile */
@media (max-width: 768px) {
	.center-grid {
		grid-template-columns: 1fr;
		padding: 1rem;
		gap: 1rem;
	}

	.page-header .title {
		font-size: 2rem;
	}

	.scoreboard {
		grid-template-columns: repeat(3, 1fr);
	}

	.choices {
		flex-direction: column;
		gap: 1rem;
		align-items: center;
	}

	.choice {
		width: 180px;
		height: 180px;
	}

	.choice .emoji {
		font-size: 5rem;
	}

	.choice .name {
		font-size: 1rem;
	}

	.right-sidebar {
		grid-column: 1 / -1;
		flex-direction: column;
	}

	.history-panel,
	.info-panel {
		width: 100%;
	}

	.button {
		padding: 0.7rem 1.2rem;
		font-size: 0.9rem;
	}
}

/* Responsive Design - Small Mobile */
@media (max-width: 540px) {
	.page-shell {
		padding: 0.75rem;
		gap: 0.75rem;
	}

	.topbar {
		padding: 0.4rem 0;
	}

	.center-grid {
		padding: 1rem;
		gap: 0.75rem;
	}

	.page-header .title {
		font-size: 1.6rem;
	}

	.subtitle {
		font-size: 0.9rem;
	}

	.score-item {
		padding: 1rem;
	}

	.score-item .value {
		font-size: 2rem;
	}

	.choice {
		width: 140px;
		height: 140px;
		gap: 0.4rem;
	}

	.choice .emoji {
		font-size: 3.5rem;
	}

	.choice .name {
		font-size: 0.8rem;
	}

	.status-row {
		padding: 1rem;
	}

	.button {
		padding: 0.6rem 1rem;
		font-size: 0.85rem;
	}

	.rules-row {
		flex-direction: column;
	}

	.rule-pill {
		width: 100%;
		justify-content: center;
	}
}

/* Responsive Design - Short Height */
@media (max-height: 700px) {
	.center-grid {
		padding: 1rem;
		gap: 0.75rem;
	}

	.choice {
		width: 160px;
		height: 160px;
	}

	.choice .emoji {
		font-size: 4.5rem;
	}

	.right-sidebar {
		gap: 1rem;
	}

	#recent-rounds {
		max-height: 250px;
	}

	.history-panel,
	.info-panel {
		padding: 1rem;
	}
}

/* Print styles */
@media print {
	.center-grid {
		box-shadow: none;
		border: 1px solid var(--border);
	}
}

/* Reduced motion support */
@media (prefers-reduced-motion: reduce) {
	*,
	*::before,
	*::after {
		animation-duration: 0.01ms !important;
		animation-iteration-count: 1 !important;
		transition-duration: 0.01ms !important;
	}
}

/* High contrast support */
@media (prefers-contrast: more) {
	:root {
		--border: rgba(100, 150, 255, 0.3);
		--text: #ffffff;
		--text-muted: #d0d8e8;
	}

	.choice {
		border-width: 3px;
	}
}
