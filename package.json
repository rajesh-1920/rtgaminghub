{
  "name": "rtgaminghub",
  "version": "1.0.0",
  "description": "A web platform of various childhood games built with HTML5, Tailwind CSS, and Vanilla JavaScript",
  "main": "index.html",
  "scripts": {
    "dev": "live-server",
    "build:css": "npx tailwindcss -i ./src/css/input.css -o ./src/css/main.css",
    "watch:css": "npx tailwindcss -i ./src/css/input.css -o ./src/css/main.css --watch"
  },
  "keywords": [
    "games",
    "childhood",
    "entertainment",
    "html5",
    "tailwind-css",
    "vanilla-js"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "tailwindcss": "^3.3.0"
  }
}
